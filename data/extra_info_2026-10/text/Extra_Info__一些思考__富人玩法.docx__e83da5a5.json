{
"t":"p",
"s":"Normal",
"text":"股票"
},
{
"t":"p",
"s":"Normal",
"text":"而是："
},
{
"t":"p",
"s":"Normal",
"text":"机会"
},
{
"t":"p",
"s":"Normal",
"text":"例如："
},
{
"t":"p",
"s":"Normal",
"text":"企业并购"
},
{
"t":"p",
"s":"Normal",
"text":"Pre-IPO"
},
{
"t":"p",
"s":"Normal",
"text":"一级市场"
},
{
"t":"p",
"s":"Normal",
"text":"VC"
},
{
"t":"p",
"s":"Normal",
"text":"PE"
},
{
"t":"p",
"s":"Normal",
"text":"房地产整栋交易"
},
{
"t":"p",
"s":"Normal",
"text":"矿山"
},
{
"t":"p",
"s":"Normal",
"text":"能源"
},
{
"t":"p",
"s":"Normal",
"text":"版权"
},
{
"t":"p",
"s":"Normal",
